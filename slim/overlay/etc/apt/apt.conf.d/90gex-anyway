// The slim image: an install of anything goes through, whatever it costs
// the packages already there (ours, wasm32, among them).
// An essential package of ours may give way to Debian's arm64 build of it
// (perl-base for an arm64 perl module)
APT::Get::allow-remove-essential "true";
// dpkg's database put right first when an earlier install stopped part way
APT::Update::Pre-Invoke { "/usr/lib/gex/apt-heal"; };
