debian/*.install only (packaging): on musl util-linux builds no col (its
configure requires glibc) and no enosys (linux/audit.h has no audit
architecture for wasm32), so the install lists leave them out there.

diff -ru a/debian/bsdextrautils.install b/debian/bsdextrautils.install
--- a/debian/bsdextrautils.install	2026-10-26 23:32:02.803003137 -0400
+++ b/debian/bsdextrautils.install	2026-10-26 23:32:02.811003152 -0400
@@ -1,12 +1,12 @@
 #!/usr/bin/dh-exec
-usr/bin/col
+[!musl-linux-any] usr/bin/col
 usr/bin/colcrt
 usr/bin/colrm
 usr/bin/column
 usr/bin/hexdump
 usr/bin/look
 usr/bin/ul
-<!nodoc> usr/share/man/man1/col.1
+[!musl-linux-any] <!nodoc> usr/share/man/man1/col.1
 <!nodoc> usr/share/man/man1/colcrt.1
 <!nodoc> usr/share/man/man1/colrm.1
 <!nodoc> usr/share/man/man1/column.1
