+/* The scalar a single-element aggregate is passed as, or NULL. */
+static ffi_type *
+single_scalar (ffi_type *t)
+{
+  while (t->type == FFI_TYPE_STRUCT)
+    {
+      ffi_type **e = t->elements;
+      ffi_type *only = NULL;
+      if (!e)
+        return NULL;
+      for (; *e; e++)
+        {
+          /* empty members do not count */
+          if ((*e)->type == FFI_TYPE_STRUCT && (*e)->size == 0)
+            continue;
+          if (only)
+            return NULL;
+          only = *e;
+        }
+      if (!only)
+        return NULL;
+      t = only;
+    }
+  return t;
