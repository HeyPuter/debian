# Copy to local.mk (untracked) and set what differs here. Everything is optional.

# Where every step writes (default: ./out). The KDE trees are a few GB.
#OUT := /fast/disk/gex-debian-out

# A gex checkout of your own, used as it is, instead of pins.mk's commit:
#GEX_DIR := ~/src/gex

# An installed gexcc toolchain (gex's tools/gexcc/install.sh), for the wasm32
# packages:
#GEXCC_PREFIX := ~/gexcc

# The wasm32 build's work area (sources, staging trees, the .deb pool):
#GEXCC_DEB := /fast/disk/gexcc-deb

#JOBS := 16
